# Backend environment configuration
# Copy this file to .env and fill in your own values. Do not commit .env.

# Application
APP_NAME=backend
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://appuser:apppass@localhost:5432/appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=appdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
SECRET_KEY=change-me-in-production-a-long-random-secret
ALGORITHM=HS256
JWT_ISSUER=fullstack-starter
JWT_AUDIENCE=fullstack-starter-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security
BCRYPT_ROUNDS=12
